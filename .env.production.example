# Production environment (copy to .env on server)
PUBLIC_APP_URL=https://pass.mstyle.ru
PUBLIC_API_URL=https://pass.mstyle.ru/api

JWT_SECRET=change-me-to-long-random-string
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=01.03.1986
ADMIN_FULL_NAME=Админ
ADMIN_ROLE=admin

# === SMTP (Spaceweb / mstyle.ru) ===
# SMTP_HOST=smtp.spaceweb.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=pass@mstyle.ru
# SMTP_PASS=your-password
# SMTP_FROM="Пропуск.М-Стиль <pass@mstyle.ru>"
#
# Для локального теста (письма только в Mailpit UI :8025):
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Пропуск.М-Стиль Офис <pass@mstyle.ru>"

# === SMS Aero (регистрация по телефону) ===
# SMSAERO_EMAIL=your@smsaero.account
# SMSAERO_API_KEY=
# Имя Мобильной авторизации (не SMS sign/list) — для pass.mstyle.ru: mts_mstyle
# SMSAERO_SIGN=mts_mstyle
# SMS_ENABLED=true
# SMSAERO_CALLBACK_URL=https://pass.mstyle.ru/api/sms/mobile-id/callback

# === Mstyle private API (off in production until explicitly enabled) ===
# MSTYLE_PRIVATE_API_ENABLED=false
# MSTYLE_CLIENT_ID=mstyle-backend-prod
# MSTYLE_CLIENT_AUTH=private_key_jwt
# MSTYLE_CLIENT_KID=mstyle-backend-prod-20260823-01
# Публичный ключ: PEM одной строкой с \n либо путь внутри backend-контейнера.
# MSTYLE_CLIENT_PUBLIC_KEY=
# MSTYLE_CLIENT_PUBLIC_KEY_FILE=/app/config/oauth-public-keys/mstyle-backend-prod-20260823-01-public.pem
# MSTYLE_CLIENT_SCOPES=mstyle.resident.authenticate mstyle.residents.read mstyle.residents.write mstyle.profiles.read mstyle.profiles.write mstyle.memberships.read mstyle.memberships.write mstyle.contacts.read mstyle.contacts.write mstyle.consents.read mstyle.consents.write mstyle.private-data.read mstyle.private-data.write mstyle.guests.read mstyle.guests.write mstyle.admin.search mstyle.changes.read
# Отдельный changes-only клиент. Ему всегда выдаётся только mstyle.changes.read.
# MSTYLE_RECONCILE_CLIENT_ID=mstyle-reconcile-prod
# MSTYLE_RECONCILE_CLIENT_AUTH=private_key_jwt
# MSTYLE_RECONCILE_CLIENT_KID=mstyle-reconcile-prod-20260823-01
# MSTYLE_RECONCILE_CLIENT_PUBLIC_KEY=
# MSTYLE_RECONCILE_CLIENT_PUBLIC_KEY_FILE=/app/config/oauth-public-keys/mstyle-reconcile-prod-20260823-01-public.pem
# OAUTH_CLIENT_PUBLIC_KEYS_DIR=/app/config/oauth-public-keys
# MSTYLE_PII_KEY=
# MSTYLE_IDEMPOTENCY_SECRET=
# Начальное значение до первого переключения в админке. В production: false.
# MSTYLE_MOCK_RESPONSES=false
# Включает реальные SIM-PUSH / SMS fallback в A-03–A-06.
# Требует SMS_ENABLED=true и заполненные SMSAERO_* выше.
# MSTYLE_DISPATCH_ENABLED=true
# MSTYLE_MOCK_OTP=1234
# MSTYLE_ENVIRONMENT=production
# MSTYLE_PUBLIC_BASE_URL=https://pass.mstyle.ru

# === Telegram OTP (отдельный контейнер + WireGuard, profile: telegram) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GATEWAY_TOKEN=
# TELEGRAM_GATEWAY_URL=http://wireguard:8091
# MSTYLE_TELEGRAM_BOT=mstyleauthbot
# Положите клиентский WG-конфиг в docker/wireguard/wg_confs/wg0.conf
# Затем: docker compose ... --profile telegram up -d --build

TZ=Europe/Moscow
# false — только 1 супер-админ при первом запуске, без тестовых аккаунтов
SEED_DEV_DATA=false

# === Mongo backups → FTP (scripts/mongo-backup.sh, cron 02:00) ===
# Локально и на FTP храним 7 дней; при бэкапе 8-го дня старые удаляются.
# RETENTION_DAYS=7
# BACKUP_FTP_ENABLED=true
# BACKUP_FTP_HOST=ftp.example.com
# BACKUP_FTP_PORT=21
# BACKUP_FTP_USER=
# BACKUP_FTP_PASS=
# BACKUP_FTP_DIR=/pass24-backups
# BACKUP_FTP_SSL=false
# BACKUP_FTP_PASSIVE=true

