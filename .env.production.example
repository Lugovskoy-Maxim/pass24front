# Production environment (copy to .env on server)
PUBLIC_APP_URL=https://pass.mstyle.ru
PUBLIC_API_URL=https://pass.mstyle.ru/api

JWT_SECRET=change-me-to-long-random-string
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=01.03.1986
ADMIN_FULL_NAME=Админ
ADMIN_ROLE=admin

# === Web Push (гость пришёл) ===
# Сгенерировать один раз и больше не менять: npx web-push generate-vapid-keys
# Смена ключей инвалидирует все браузерные подписки (FCM 403).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:pass@mstyle.ru

# === SMTP (Spaceweb / mstyle.ru) ===
# Укажите пароль ящика перед запуском. Mailpit используется только локально.
SMTP_HOST=smtp.spaceweb.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pass@mstyle.ru
SMTP_PASS=
SMTP_FROM="Пропуск.М-Стиль Офис <pass@mstyle.ru>"

# === SMS Aero (регистрация по телефону) ===
# SMSAERO_EMAIL=your@smsaero.account
# SMSAERO_API_KEY=
# Имя Мобильной авторизации (не SMS sign/list) — для pass.mstyle.ru: mts_mstyle
# SMSAERO_SIGN=mts_mstyle
# SMS_ENABLED=true
# SMSAERO_CALLBACK_URL=https://pass.mstyle.ru/api/sms/mobile-id/callback

# Отдельный кабинет SMS Aero для авторизации V2 / mstyle.ru.
# Без этих настроек V2 не использует учётные данные регистрации PASS.
MSTYLE_SMS_ENABLED=false
MSTYLE_SMSAERO_EMAIL=
MSTYLE_SMSAERO_API_KEY=
MSTYLE_SMSAERO_SIGN=
MSTYLE_SMSAERO_CALLBACK_URL=https://pass.mstyle.ru/api/sms/mobile-id/callback

# === Mstyle private API (off in production until explicitly enabled) ===
# MSTYLE_PRIVATE_API_ENABLED=false
# MSTYLE_CLIENT_ID=mstyle-backend-prod
# MSTYLE_CLIENT_AUTH=private_key_jwt
# MSTYLE_CLIENT_KID=mstyle-backend-prod-20260823-01
# Публичный ключ: PEM одной строкой с \n либо путь внутри backend-контейнера.
# MSTYLE_CLIENT_PUBLIC_KEY=
# MSTYLE_CLIENT_PUBLIC_KEY_FILE=/app/config/oauth-public-keys/mstyle-backend-prod-20260823-01-public.pem
# MSTYLE_CLIENT_SCOPES=mstyle.guest.booking.confirm mstyle.guest.create mstyle.guest.read mstyle.guest.claim mstyle.guest.contact.read mstyle.guest.private.reveal mstyle.guest.snapshot.contact.reveal mstyle.guest.snapshot.private.reveal mstyle.integration.admin.members.read mstyle.integration.admin.profile.read mstyle.integration.admin.profile.write mstyle.integration.admin.identity.read mstyle.integration.admin.physical_access.read mstyle.integration.admin.change_request.decide mstyle.integration.admin.guest.read mstyle.integration.admin.onboarding.write mstyle.resident.authenticate mstyle.resident.consent.read mstyle.resident.consent.write mstyle.resident.contact.read mstyle.resident.contact.write mstyle.resident.context.read mstyle.resident.identity.write mstyle.resident.members.read mstyle.resident.members.write mstyle.resident.private.reveal mstyle.resident.private.status.read mstyle.resident.private.write mstyle.resident.profile.read mstyle.resident.profile.write mstyle.resident.snapshot.create mstyle.resident.snapshot.contact.reveal mstyle.resident.snapshot.private.reveal mstyle.resident.physical_access.read mstyle.resident.change_request.read mstyle.resident.change_request.write mstyle.snapshot.operation.bind
# Отдельный changes-only клиент: mstyle.integration.reconcile (старое имя mstyle.changes.read тоже принимается).
# MSTYLE_RECONCILE_CLIENT_ID=mstyle-reconcile-prod
# MSTYLE_RECONCILE_CLIENT_AUTH=private_key_jwt
# MSTYLE_RECONCILE_CLIENT_KID=mstyle-reconcile-prod-20260823-01
# MSTYLE_RECONCILE_CLIENT_PUBLIC_KEY=
# MSTYLE_RECONCILE_CLIENT_PUBLIC_KEY_FILE=/app/config/oauth-public-keys/mstyle-reconcile-prod-20260823-01-public.pem
# OAUTH_CLIENT_PUBLIC_KEYS_DIR=/app/config/oauth-public-keys
# MSTYLE_PII_KEY=
# MSTYLE_IDEMPOTENCY_SECRET=
# HMAC-секрет для X-Admin-Step-Up-Assertion формата v1.<payload>.<hmac>.
# Если пусто, используется MSTYLE_IDEMPOTENCY_SECRET.
# MSTYLE_ADMIN_ASSERTION_SECRET=
# Начальное значение до первого переключения в админке. В production: false.
# MSTYLE_MOCK_RESPONSES=false
# Включает отправку кодов email / Telegram и SIM-PUSH / SMS fallback.
# Email требует SMTP_*; SMS V2 требует MSTYLE_SMS_ENABLED=true и MSTYLE_SMSAERO_*.
MSTYLE_DISPATCH_ENABLED=true
# MSTYLE_MOCK_OTP=1234
# MSTYLE_ENVIRONMENT=production
# MSTYLE_PUBLIC_BASE_URL=https://pass.mstyle.ru

# === Telegram OTP (отдельный контейнер + WireGuard, profile: telegram) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GATEWAY_TOKEN=
# TELEGRAM_GATEWAY_URL=http://wireguard:8091
# TELEGRAM_POLL=true
# COMPOSE_PROFILES=telegram
MSTYLE_TELEGRAM_BOT=m_style_office_bot
# Положите клиентский WG-конфиг в docker/wireguard/wg_confs/wg0.conf
# Затем: docker compose ... --profile telegram up -d --build

TZ=Europe/Moscow
# false — только 1 супер-админ при первом запуске, без тестовых аккаунтов
SEED_DEV_DATA=false

# Single-node replica set обязателен для транзакций интеграции Mstyle V2.
MONGO_REPLICA_SET=rs0
MONGO_REPLICA_HOST=mongo:27017

# === Mongo backups → FTP (scripts/mongo-backup.sh, cron 02:00) ===
# Локально и на FTP храним 7 дней; при бэкапе 8-го дня старые удаляются.
# RETENTION_DAYS=7
# BACKUP_FTP_ENABLED=true
# BACKUP_FTP_HOST=ftp.example.com
# BACKUP_FTP_PORT=21
# BACKUP_FTP_USER=
# BACKUP_FTP_PASS=
# BACKUP_FTP_DIR=/pass24-backups
# BACKUP_FTP_SSL=false
# BACKUP_FTP_PASSIVE=true
## Интеграция Мстиль: дополнительные параметры
# Перед запуском заполнить действительный документ согласия. [] означает, что документы не настроены.
MSTYLE_CONSENT_DOCUMENTS_JSON=[]
MSTYLE_CLIENT_JWT_ALG=RS256
MSTYLE_CLIENT_ADMIN_ALLOWED=true
MSTYLE_RECONCILE_JWT_ALG=RS256
MSTYLE_PRIVATE_API_BASE=https://pass.mstyle.ru/api/internal/integrations/mstyle/v2
