{
  "info": {
    "_postman_id": "8a1b6a0c-7a57-4a55-9d3a-99a8ed0a6c24",
    "name": "M-Style Pass24 OAuth",
    "description": "Проверка private_key_jwt для https://pass.mstyle.ru/api/oauth2/token. Приватные ключи не включены: вставьте их в переменные коллекции backend_private_key_pem и reconcile_private_key_pem. Pre-request script использует jsrsasign для RS256 подписи.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const tokenUrl = pm.collectionVariables.get('token_url');",
          "const configs = {",
          "  backend: {",
          "    clientId: 'mstyle-backend-prod',",
          "    kid: 'mstyle-backend-prod-20260823-01',",
          "    scope: 'mstyle.resident.authenticate mstyle.residents.read mstyle.residents.write mstyle.profiles.read mstyle.profiles.write mstyle.memberships.read mstyle.memberships.write mstyle.contacts.read mstyle.contacts.write mstyle.consents.read mstyle.consents.write mstyle.private-data.read mstyle.private-data.write mstyle.guests.read mstyle.guests.write mstyle.admin.search mstyle.changes.read',",
          "    privateKeyVar: 'backend_private_key_pem'",
          "  },",
          "  reconcile: {",
          "    clientId: 'mstyle-reconcile-prod',",
          "    kid: 'mstyle-reconcile-prod-20260823-01',",
          "    scope: 'mstyle.changes.read',",
          "    privateKeyVar: 'reconcile_private_key_pem'",
          "  }",
          "};",
          "",
          "const requestName = (pm.info.requestName || '').toLowerCase();",
          "const cfg = requestName.includes('reconcile') ? configs.reconcile : configs.backend;",
          "const privateKeyPem = (pm.collectionVariables.get(cfg.privateKeyVar) || '').replace(/\\\\n/g, '\\n').trim();",
          "",
          "if (!privateKeyPem) {",
          "  throw new Error(`Заполните collection variable ${cfg.privateKeyVar}: вставьте private key PEM, начиная с -----BEGIN PRIVATE KEY-----`);",
          "}",
          "",
          "function makeAssertion() {",
          "  const now = Math.floor(Date.now() / 1000);",
          "  const header = { alg: 'RS256', typ: 'JWT', kid: cfg.kid };",
          "  const payload = {",
          "    iss: cfg.clientId,",
          "    sub: cfg.clientId,",
          "    aud: tokenUrl,",
          "    jti: `${Date.now()}-${Math.random().toString(36).slice(2)}`,",
          "    iat: now,",
          "    exp: now + 60",
          "  };",
          "",
          "  const assertion = KJUR.jws.JWS.sign('RS256', JSON.stringify(header), JSON.stringify(payload), privateKeyPem);",
          "  pm.collectionVariables.set('oauth_client_id', cfg.clientId);",
          "  pm.collectionVariables.set('oauth_kid', cfg.kid);",
          "  pm.collectionVariables.set('oauth_scope', cfg.scope);",
          "  pm.collectionVariables.set('client_assertion', assertion);",
          "}",
          "",
          "if (typeof KJUR !== 'undefined') {",
          "  makeAssertion();",
          "} else {",
          "  pm.sendRequest(pm.collectionVariables.get('jsrsasign_url'), function (err, res) {",
          "    if (err) throw err;",
          "    eval(res.text());",
          "    makeAssertion();",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Token - backend",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{oauth_client_id}}",
              "type": "text"
            },
            {
              "key": "client_assertion_type",
              "value": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
              "type": "text"
            },
            {
              "key": "client_assertion",
              "value": "{{client_assertion}}",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "{{oauth_scope}}",
              "type": "text"
            }
          ]
        },
        "url": "{{token_url}}",
        "description": "client_id=mstyle-backend-prod, JWT header kid=mstyle-backend-prod-20260823-01, alg=RS256."
      },
      "response": []
    },
    {
      "name": "Token - reconcile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{oauth_client_id}}",
              "type": "text"
            },
            {
              "key": "client_assertion_type",
              "value": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
              "type": "text"
            },
            {
              "key": "client_assertion",
              "value": "{{client_assertion}}",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "{{oauth_scope}}",
              "type": "text"
            }
          ]
        },
        "url": "{{token_url}}",
        "description": "client_id=mstyle-reconcile-prod, JWT header kid=mstyle-reconcile-prod-20260823-01, alg=RS256."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "token_url",
      "value": "https://pass.mstyle.ru/api/oauth2/token",
      "type": "string"
    },
    {
      "key": "backend_private_key_pem",
      "value": "",
      "type": "string"
    },
    {
      "key": "reconcile_private_key_pem",
      "value": "",
      "type": "string"
    },
    {
      "key": "oauth_client_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "oauth_kid",
      "value": "",
      "type": "string"
    },
    {
      "key": "oauth_scope",
      "value": "",
      "type": "string"
    },
    {
      "key": "client_assertion",
      "value": "",
      "type": "string"
    },
    {
      "key": "jsrsasign_url",
      "value": "https://cdnjs.cloudflare.com/ajax/libs/jsrsasign/10.9.0/jsrsasign-all-min.js",
      "type": "string"
    }
  ]
}
