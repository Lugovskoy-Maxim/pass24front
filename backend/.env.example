# Backend configuration
PORT=4000

# === MongoDB Connection ===
# Local MongoDB (operational data: passes, offices, audit):
MONGODB_URI=mongodb://localhost:27017/pass24

# Auth / identity database (users, future Bitrix24 integration):
# Defaults to pass24_auth on the same host as MONGODB_URI if omitted.
MONGODB_AUTH_URI=mongodb://localhost:27017/pass24_auth

# MongoDB Atlas (recommended for development):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pass24?retryWrites=true&w=majority
# MONGODB_AUTH_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pass24_auth?retryWrites=true&w=majority

# JWT
JWT_SECRET=pass24-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Default admin (created on startup if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=01.03.1986
ADMIN_FULL_NAME=Админ

# === Docker MongoDB settings ===
# Custom path for Mongo data when using docker compose (bind mount)
# MONGO_DATA_PATH=./data/mongo

# Frontend uses: NEXT_PUBLIC_API_URL=http://localhost:4000/api (see frontend/.env.local)

# === Email (SMTP) ===
# Docker Compose uses Mailpit by default (UI: http://127.0.0.1:8025)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=Пропуск.М-Стиль <pass@mstyle.ru>
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Public URL of the frontend (for links in emails)
# PUBLIC_APP_URL=http://127.0.0.1:3000

# CORS (optional, defaults allow local frontend)
# CORS_ORIGIN=http://localhost:3000

# === Web Push: уведомления арендаторам о приходе гостей ===
# Сгенерировать один раз: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# === SMS Aero Mobile Authorization (phone registration) ===
# Login = account email from https://smsaero.ru/cabinet/settings/apikey/
# SMSAERO_EMAIL=your@smsaero.account
# SMSAERO_API_KEY=
# Имя для Мобильной авторизации (не обычная SMS-подпись sign/list), напр. mts_mstyle
# SMSAERO_SIGN=mts_mstyle
# SMS_ENABLED=true
# Callback статусов Mobile ID (по умолчанию {PUBLIC_APP_URL}/api/sms/mobile-id/callback)
# SMSAERO_CALLBACK_URL=https://pass.mstyle.ru/api/sms/mobile-id/callback

# === Mstyle private API (эндпоинты.md) ===
# В production по умолчанию выключено. Dev — включено.
# MSTYLE_PRIVATE_API_ENABLED=true
# MSTYLE_CLIENT_ID=mstyle-backend-staging
# mTLS (мок: только client_id) или private_key_jwt
# MSTYLE_CLIENT_AUTH=mtls
# MSTYLE_CLIENT_PUBLIC_KEY=
# MSTYLE_CLIENT_SCOPES=
# MSTYLE_TOKEN_TTL_SEC=300
# MSTYLE_TOKEN_AUD=pass-mstyle-private-api
# MSTYLE_TOKEN_ENDPOINT_AUD=
# MSTYLE_PII_KEY=
# MSTYLE_IDEMPOTENCY_SECRET=
# MSTYLE_MOCK_OTP=123456
# MSTYLE_TELEGRAM_BOT=mstyleauthbot
# MSTYLE_ENVIRONMENT=staging
# MSTYLE_PUBLIC_BASE_URL=http://localhost:4000
# MSTYLE_DISPATCH_ENABLED=false

# SMPP (optional, for bulk campaigns — not used for registration OTP)
# SMPP_HOST=smpp.smsaero.ru
# SMPP_IP=82.202.194.38
# SMPP_PORT=2775
